NODE_ENV=production
PORT=4000
FRONTEND_URL=http://shellotech.eu.org
TRUST_PROXY=1

MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-this-password
MONGO_DB=shello_db
MONGO_URI=mongodb://admin:change-this-password@mongo:27017/shello_db?authSource=admin

JWT_SECRET=replace-with-strong-secret
REFRESH_SECRET=replace-with-strong-secret
REFRESH_TOKEN_HMAC_KEY=replace-with-strong-secret
TWO_FACTOR_ENCRYPTION_KEY=replace-with-strong-secret

BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Optional admin bootstrap
# SUPER_ADMIN_EMAIL=admin@shello.local
# SUPER_ADMIN_PASSWORD=Admin@12345
# SUPER_ADMIN_PIN_CODE=000001
# SUPER_ADMIN_NAME=Shello
# SUPER_ADMIN_LAST_NAME=Admin

# Optional Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://shellotech.eu.org/api/v1/auth/google/callback
# GOOGLE_ALLOWED_ORIGIN=http://shellotech.eu.org
