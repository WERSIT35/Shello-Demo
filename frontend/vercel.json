{
  "outputDirectory": "dist/frontend/browser/browser",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://shello-demo-api.onrender.com/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://shello-demo-api.onrender.com/uploads/$1" },
    { "source": "/ka", "destination": "/shellotech/ka/index.html" },
    { "source": "/ka/(.*)", "destination": "/shellotech/ka/index.html" },
    { "source": "/en", "destination": "/shellotech/index.html" },
    { "source": "/en/(.*)", "destination": "/shellotech/index.html" },
    { "source": "/", "destination": "/shellotech/index.html" },
    { "source": "/(.*)", "destination": "/shellotech/index.html" }
  ]
}
